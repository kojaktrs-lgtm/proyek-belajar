// Berdasarkan "Multi Timeframe Support and Resistance" © SUAR PRO
// Modifikasi:
//  - Setiap swing high (HH/LH) = resistance, setiap swing low (HL/LL) = support
//  - Semua swing yang BELUM tersentuh tetap ditampilkan sebagai SnR
//  - Support yang sudah terinjak & resistance yang sudah ditembus dihapus
//  - Label struktur pasar HH / LH / HL / LL di setiap level
//  - Mode Body memakai badan candle (max/min dari open & close)
//  - Pivot kiri & kanan terpisah, agar swing kecil / baru tetap terdeteksi
//  - Data timeframe besar tidak repaint (candle HTF yang sudah close)
//  - Timeframe yang lebih kecil / sama dengan chart dilewati (datanya tidak akurat)
//  - Garis dimulai TEPAT dari candle pembentuk pivot dan lurus sampai candle terakhir
//  - Level yang berdekatan digabung

//@version=5
indicator(title = "Multi Timeframe Nearest Support and Resistance", shorttitle = "Nearest SnR MTF", overlay = true, max_lines_count = 500, max_labels_count = 500)

// SnR Levels
left_bars  = input.int(5, title = "Pivot Kiri", minval = 1,
     tooltip = "Jumlah candle SEBELUM puncak/lembah yang harus lebih rendah/lebih tinggi. Makin kecil, swing kecil makin banyak terdeteksi.")
right_bars = input.int(3, title = "Pivot Kanan", minval = 1,
     tooltip = "Jumlah candle SESUDAH puncak/lembah untuk konfirmasi. Garis baru muncul setelah sejumlah candle ini terbentuk. Makin kecil, makin cepat muncul.")
tipe       = input.string("Body", title = "Type", options = ["Wick", "Body"])
show_n     = input.int(0, title = "Jumlah Garis per Sisi (0 = semua)", minval = 0, maxval = 50,
     tooltip = "0 = tampilkan SEMUA swing yang belum tersentuh. Isi angka (mis. 3) untuk hanya menampilkan sejumlah resistance & support terdekat dari harga.")
keep       = input.int(100, title = "Maksimal Level Disimpan", minval = 2, maxval = 500,
     tooltip = "Batas jumlah level aktif per sisi per timeframe. Jika lebih, level yang PALING JAUH dari harga yang dibuang.")
hapus      = input.string("Tersentuh", title = "Hapus Level Jika", options = ["Tersentuh", "Ditembus Close"],
     tooltip = "Tersentuh = level dihapus begitu harga menyentuhnya (Type Wick: high/low, Type Body: badan candle). Ditembus Close = level dihapus jika candle close melewatinya.")
gabung     = input.float(0.3, title = "Gabung Level Berdekatan (x ATR)", minval = 0, step = 0.1,
     tooltip = "Pivot baru yang jaraknya kurang dari nilai ini (dikali ATR 14) dari level yang sudah ada tidak dibuat level baru. Isi 0 untuk mematikan.")
show_lbl   = input.bool(true, title = "Label HH / LH / HL / LL")

show_c    = input.bool(true,  title = "Current Timeframe", group = "Timeframes")
show_5m   = input.bool(false, title = "M5",     group = "Timeframes")
show_15m  = input.bool(false, title = "M15",    group = "Timeframes")
show_30m  = input.bool(false, title = "M30",    group = "Timeframes")
show_1h   = input.bool(false, title = "H1",     group = "Timeframes")
show_4h   = input.bool(false, title = "H4",     group = "Timeframes")
show_d    = input.bool(false, title = "Daily",  group = "Timeframes")
show_w    = input.bool(false, title = "Weekly", group = "Timeframes")

use_wick  = tipe == "Wick"
tol       = ta.atr(14) * gabung
src_high  = use_wick ? high : math.max(open, close)
src_low   = use_wick ? low  : math.min(open, close)

// Pivot high & low + waktu candle pivot. Body = bagian atas/bawah badan candle.
// delay = 1 dipakai untuk timeframe besar agar hanya memakai candle HTF yang sudah close.
pivots(int left, int right, bool wick, int delay) =>
    float hi = wick ? high : math.max(open, close)
    float lo = wick ? low  : math.min(open, close)
    float ph = ta.pivothigh(hi, left, right)
    float pl = ta.pivotlow(lo, left, right)
    [ph[delay], pl[delay], time[right + delay]]

// Hanya timeframe yang lebih besar dari chart yang dipakai.
is_higher(string tf) =>
    timeframe.in_seconds(tf) > timeframe.in_seconds(timeframe.period)

htf_pivots(string tf) =>
    request.security(syminfo.tickerid, tf, pivots(left_bars, right_bars, use_wick, 1), lookahead = barmerge.lookahead_on)

// Untuk timeframe besar: cari candle CHART yang menjadi titik tertinggi / terendah
// di dalam setiap candle HTF, supaya garis HTF dimulai tepat di candle pembentuk pivot.
htf_anchor(string tf, int right) =>
    var hi_hist  = array.new_int()
    var lo_hist  = array.new_int()
    var float cur_hi   = na
    var float cur_lo   = na
    var int   cur_hi_t = na
    var int   cur_lo_t = na
    bool new_htf = timeframe.change(tf)
    if new_htf and not na(cur_hi_t)
        array.push(hi_hist, cur_hi_t)
        array.push(lo_hist, cur_lo_t)
        if array.size(hi_hist) > right + 2
            array.shift(hi_hist)
            array.shift(lo_hist)
        cur_hi := na
        cur_lo := na
    if na(cur_hi) or src_high > cur_hi
        cur_hi   := src_high
        cur_hi_t := time
    if na(cur_lo) or src_low < cur_lo
        cur_lo   := src_low
        cur_lo_t := time
    int idx  = array.size(hi_hist) - 1 - right
    int hi_t = idx >= 0 ? array.get(hi_hist, idx) : na
    int lo_t = idx >= 0 ? array.get(lo_hist, idx) : na
    [hi_t, lo_t]

// Pakai waktu candle chart jika memang berada di dalam candle HTF pivot,
// jika tidak (history chart kurang panjang) pakai waktu candle HTF.
anchor_time(int chart_t, int htf_t, string tf) =>
    bool ok = not na(chart_t) and not na(htf_t) and chart_t >= htf_t and chart_t < htf_t + timeframe.in_seconds(tf) * 1000
    ok ? chart_t : htf_t

// Cek apakah sudah ada level yang jaraknya <= tol dari harga baru.
has_near(float[] arr, float price) =>
    bool found = false
    if array.size(arr) > 0 and tol > 0
        for lvl in arr
            if math.abs(lvl - price) <= tol
                found := true
                break
    found

// Jika level melebihi batas, buang yang paling jauh dari harga.
trim(float[] levels, int[] times, string[] kinds) =>
    while array.size(levels) > keep
        int   far_i = 0
        float far_d = -1.0
        for i = 0 to array.size(levels) - 1
            float d = math.abs(array.get(levels, i) - close)
            if d > far_d
                far_d := d
                far_i := i
        array.remove(levels, far_i)
        array.remove(times, far_i)
        array.remove(kinds, far_i)

// Semua garis & label yang sedang tampil (digambar ulang di candle terakhir).
var drawn_lines  = array.new_line()
var drawn_labels = array.new_label()
if barstate.islast
    while array.size(drawn_lines) > 0
        line.delete(array.pop(drawn_lines))
    while array.size(drawn_labels) > 0
        label.delete(array.pop(drawn_labels))

// Gambar level dari yang terdekat: lurus dari candle pivot sampai candle terakhir.
// Resistance: urut naik (terendah = terdekat). Support: urut turun (tertinggi = terdekat).
draw_levels(float[] levels, int[] times, string[] kinds, bool is_res, color col, string tf_name) =>
    int sz = array.size(levels)
    if sz > 0
        int[] idx = array.sort_indices(levels, is_res ? order.ascending : order.descending)
        int n = show_n == 0 ? sz : math.min(show_n, sz)
        for k = 0 to n - 1
            int   i     = array.get(idx, k)
            float price = array.get(levels, i)
            int   t     = array.get(times, i)
            if not na(t)
                array.push(drawn_lines, line.new(t, price, time, price, xloc = xloc.bar_time, color = col, width = 2))
                if show_lbl
                    string txt = tf_name == "" ? array.get(kinds, i) : array.get(kinds, i) + " " + tf_name
                    array.push(drawn_labels, label.new(t, price, txt, xloc = xloc.bar_time,
                         style = is_res ? label.style_label_down : label.style_label_up,
                         color = color.new(color.black, 100), textcolor = col, size = size.small))

// Swing high -> resistance (HH jika lebih tinggi dari swing high sebelumnya, LH jika lebih rendah).
// Swing low  -> support    (HL jika lebih tinggi dari swing low sebelumnya,  LL jika lebih rendah).
// Level yang ditembus / terinjak dihapus; sisanya (semua yang belum tersentuh) digambar.
// Setiap pemanggilan fungsi punya memori (var) sendiri, jadi tiap timeframe terpisah.
snr(float ph, float pl, int ph_t, int pl_t, bool is_new, bool enabled, color res_col, color sup_col, string tf_name) =>
    var res_levels = array.new_float()
    var res_times  = array.new_int()
    var res_kinds  = array.new_string()
    var sup_levels = array.new_float()
    var sup_times  = array.new_int()
    var sup_kinds  = array.new_string()
    var float last_ph = na
    var float last_pl = na
    if enabled
        if is_new
            if not na(ph)
                string kind = na(last_ph) ? "H" : ph > last_ph ? "HH" : ph < last_ph ? "LH" : "EQH"
                last_ph := ph
                if not has_near(res_levels, ph)
                    array.push(res_levels, ph)
                    array.push(res_times, ph_t)
                    array.push(res_kinds, kind)
            if not na(pl)
                string kind = na(last_pl) ? "L" : pl > last_pl ? "HL" : pl < last_pl ? "LL" : "EQL"
                last_pl := pl
                if not has_near(sup_levels, pl)
                    array.push(sup_levels, pl)
                    array.push(sup_times, pl_t)
                    array.push(sup_kinds, kind)

        bool  by_touch  = hapus == "Tersentuh"
        float top_price = by_touch ? src_high : close
        float bot_price = by_touch ? src_low  : close

        // Loop mundur supaya aman saat menghapus elemen array
        if array.size(res_levels) > 0
            for i = array.size(res_levels) - 1 to 0
                lvl = array.get(res_levels, i)
                if by_touch ? top_price >= lvl : top_price > lvl
                    array.remove(res_levels, i)
                    array.remove(res_times, i)
                    array.remove(res_kinds, i)

        if array.size(sup_levels) > 0
            for i = array.size(sup_levels) - 1 to 0
                lvl = array.get(sup_levels, i)
                if by_touch ? bot_price <= lvl : bot_price < lvl
                    array.remove(sup_levels, i)
                    array.remove(sup_times, i)
                    array.remove(sup_kinds, i)

        trim(res_levels, res_times, res_kinds)
        trim(sup_levels, sup_times, sup_kinds)

        if barstate.islast
            draw_levels(res_levels, res_times, res_kinds, true,  res_col, tf_name)
            draw_levels(sup_levels, sup_times, sup_kinds, false, sup_col, tf_name)

// Pivot
[ph_c,   pl_c,   t_c  ] = pivots(left_bars, right_bars, use_wick, 0)
[ph_5m,  pl_5m,  t_5m ] = htf_pivots("5")
[ph_15m, pl_15m, t_15m] = htf_pivots("15")
[ph_30m, pl_30m, t_30m] = htf_pivots("30")
[ph_1h,  pl_1h,  t_1h ] = htf_pivots("60")
[ph_4h,  pl_4h,  t_4h ] = htf_pivots("240")
[ph_d,   pl_d,   t_d  ] = htf_pivots("D")
[ph_w,   pl_w,   t_w  ] = htf_pivots("W")

// Candle chart pembentuk pivot HTF
[ah_5m,  al_5m ] = htf_anchor("5",   right_bars)
[ah_15m, al_15m] = htf_anchor("15",  right_bars)
[ah_30m, al_30m] = htf_anchor("30",  right_bars)
[ah_1h,  al_1h ] = htf_anchor("60",  right_bars)
[ah_4h,  al_4h ] = htf_anchor("240", right_bars)
[ah_d,   al_d  ] = htf_anchor("D",   right_bars)
[ah_w,   al_w  ] = htf_anchor("W",   right_bars)

// Support & resistance per timeframe
snr(ph_5m,  pl_5m,  anchor_time(ah_5m,  t_5m,  "5"),   anchor_time(al_5m,  t_5m,  "5"),   timeframe.change("5"),   show_5m  and is_higher("5"),   #00aeff,   #ffbf00,   "M5")
snr(ph_15m, pl_15m, anchor_time(ah_15m, t_15m, "15"),  anchor_time(al_15m, t_15m, "15"),  timeframe.change("15"),  show_15m and is_higher("15"),  #00aeffdd, #ffbf00dd, "M15")
snr(ph_30m, pl_30m, anchor_time(ah_30m, t_30m, "30"),  anchor_time(al_30m, t_30m, "30"),  timeframe.change("30"),  show_30m and is_higher("30"),  #00aeffbb, #ffbf00bb, "M30")
snr(ph_1h,  pl_1h,  anchor_time(ah_1h,  t_1h,  "60"),  anchor_time(al_1h,  t_1h,  "60"),  timeframe.change("60"),  show_1h  and is_higher("60"),  #00aeff90, #ffbf0090, "H1")
snr(ph_4h,  pl_4h,  anchor_time(ah_4h,  t_4h,  "240"), anchor_time(al_4h,  t_4h,  "240"), timeframe.change("240"), show_4h  and is_higher("240"), #00aeff70, #ffbf0070, "H4")
snr(ph_d,   pl_d,   anchor_time(ah_d,   t_d,   "D"),   anchor_time(al_d,   t_d,   "D"),   timeframe.change("D"),   show_d   and is_higher("D"),   #00aeff50, #ffbf0050, "D")
snr(ph_w,   pl_w,   anchor_time(ah_w,   t_w,   "W"),   anchor_time(al_w,   t_w,   "W"),   timeframe.change("W"),   show_w   and is_higher("W"),   #00aeff30, #ffbf0030, "W")
snr(ph_c,   pl_c,   t_c, t_c, true, show_c, #ff0040, #6aff00, "")

// Adaptive Moving Average
plot_ama   = input.bool(false, title = "Adaptive Moving Average")
ama_length = input.int(15, title = "Line Length")
ama_src    = close
float ama  = 0
hh         = math.max(math.sign(ta.change(ta.highest(ama_length))), 0)
ll         = math.max(math.sign(ta.change(ta.lowest(ama_length)) * -1), 0)
tc         = math.pow(ta.sma(hh or ll ? 1 : 0, ama_length), 2)

ama := nz(ama[1] + tc * (ama_src - ama[1]), ama_src)

garis_ama  = plot(plot_ama ? ama : na, "Adaptive Moving Average", #ffffff, 2)
