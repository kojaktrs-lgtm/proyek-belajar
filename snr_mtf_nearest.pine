// Berdasarkan "Multi Timeframe Support and Resistance" © SUAR PRO
// Modifikasi:
//  - Swing dideteksi dengan ZigZag (struktur pasar): sebuah puncak / lembah baru diakui
//    jika harga sudah berbalik minimal X%. Ayunan kecil diabaikan.
//  - Puncak swing = resistance, lembah swing = support
//  - Hanya swing yang BELUM tersentuh yang ditampilkan; yang ditembus / terinjak dihapus
//  - Dibatasi periode dan jumlah garis terdekat agar chart tidak penuh
//  - Mode Body memakai badan candle (max/min dari open & close)
//  - Data timeframe besar tidak repaint (candle HTF yang sudah close)
//  - Timeframe yang lebih kecil / sama dengan chart dilewati (datanya tidak akurat)
//  - Garis dimulai TEPAT dari candle pembentuk swing dan lurus sampai candle terakhir

//@version=5
indicator(title = "Multi Timeframe Nearest Support and Resistance", shorttitle = "Nearest SnR MTF", overlay = true, max_lines_count = 500, max_bars_back = 5000)

// SnR Levels
swing_pct = input.float(20.0, title = "Minimal Swing (%)", minval = 0.1, step = 0.5,
     tooltip = "Puncak/lembah baru diakui sebagai SnR jika harga sudah berbalik minimal sebesar ini. Makin besar, makin sedikit dan makin besar swing yang dipakai. Saham harian: 15-25%. Intraday/forex: 1-5%.")
tipe      = input.string("Body", title = "Type", options = ["Wick", "Body"])
periode   = input.int(300, title = "Periode (jumlah candle, 0 = semua)", minval = 0, maxval = 4999,
     tooltip = "Swing yang lebih lama dari jumlah candle ini diabaikan.")
show_n    = input.int(3, title = "Jumlah Garis per Sisi (0 = semua)", minval = 0, maxval = 50,
     tooltip = "Berapa resistance terdekat (di atas harga) dan support terdekat (di bawah harga) yang ditampilkan per timeframe.")
hapus     = input.string("Tersentuh", title = "Hapus Level Jika", options = ["Tersentuh", "Ditembus Close"],
     tooltip = "Tersentuh = level dihapus begitu harga menyentuhnya (Type Wick: high/low, Type Body: badan candle). Ditembus Close = level dihapus jika candle close melewatinya.")
gabung    = input.float(0.3, title = "Gabung Level Berdekatan (x ATR)", minval = 0, step = 0.1,
     tooltip = "Swing baru yang jaraknya kurang dari nilai ini (dikali ATR 14) dari level lama menggantikan level lama tersebut. Isi 0 untuk mematikan.")

show_c    = input.bool(true,  title = "Current Timeframe", group = "Timeframes")
show_5m   = input.bool(false, title = "M5",     group = "Timeframes")
show_15m  = input.bool(false, title = "M15",    group = "Timeframes")
show_30m  = input.bool(false, title = "M30",    group = "Timeframes")
show_1h   = input.bool(false, title = "H1",     group = "Timeframes")
show_4h   = input.bool(false, title = "H4",     group = "Timeframes")
show_d    = input.bool(false, title = "Daily",  group = "Timeframes")
show_w    = input.bool(false, title = "Weekly", group = "Timeframes")

use_wick  = tipe == "Wick"
tol       = ta.atr(14) * gabung
src_high  = use_wick ? high : math.max(open, close)
src_low   = use_wick ? low  : math.min(open, close)
int cutoff_t = periode > 0 ? time[periode] : na

// ZigZag: lacak puncak/lembah sementara. Puncak dikonfirmasi saat harga turun pct% darinya,
// lembah dikonfirmasi saat harga naik pct% darinya. Mengembalikan harga & waktu candle swing.
// delay = 1 dipakai untuk timeframe besar agar hanya memakai candle HTF yang sudah close.
zigzag(float pct, bool wick, int delay) =>
    float hi = wick ? high : math.max(open, close)
    float lo = wick ? low  : math.min(open, close)
    float d  = pct / 100
    var int   dir       = 0
    var float cand_hi   = na
    var float cand_lo   = na
    var int   cand_hi_t = na
    var int   cand_lo_t = na
    float sw_hi   = na
    float sw_lo   = na
    int   sw_hi_t = na
    int   sw_lo_t = na
    if na(cand_hi)
        cand_hi   := hi
        cand_lo   := lo
        cand_hi_t := time
        cand_lo_t := time
    else if dir == 1
        if hi > cand_hi
            cand_hi   := hi
            cand_hi_t := time
        else if lo <= cand_hi * (1 - d)
            sw_hi     := cand_hi
            sw_hi_t   := cand_hi_t
            dir       := -1
            cand_lo   := lo
            cand_lo_t := time
    else if dir == -1
        if lo < cand_lo
            cand_lo   := lo
            cand_lo_t := time
        else if hi >= cand_lo * (1 + d)
            sw_lo     := cand_lo
            sw_lo_t   := cand_lo_t
            dir       := 1
            cand_hi   := hi
            cand_hi_t := time
    else
        if hi > cand_hi
            cand_hi   := hi
            cand_hi_t := time
        if lo < cand_lo
            cand_lo   := lo
            cand_lo_t := time
        if cand_hi >= cand_lo * (1 + d) and cand_hi_t > cand_lo_t
            sw_lo   := cand_lo
            sw_lo_t := cand_lo_t
            dir     := 1
        else if cand_lo <= cand_hi * (1 - d) and cand_lo_t > cand_hi_t
            sw_hi   := cand_hi
            sw_hi_t := cand_hi_t
            dir     := -1
    [sw_hi[delay], sw_lo[delay], sw_hi_t[delay], sw_lo_t[delay]]

// Hanya timeframe yang lebih besar dari chart yang dipakai.
is_higher(string tf) =>
    timeframe.in_seconds(tf) > timeframe.in_seconds(timeframe.period)

htf_swings(string tf) =>
    request.security(syminfo.tickerid, tf, zigzag(swing_pct, use_wick, 1), lookahead = barmerge.lookahead_on)

// Cari nilai berdasarkan kunci waktu candle HTF (dari belakang).
find_time(int[] keys, int[] vals, int key) =>
    int res = na
    int sz  = array.size(keys)
    if not na(key) and sz > 0
        for i = sz - 1 to 0
            int k = array.get(keys, i)
            if k == key
                res := array.get(vals, i)
                break
            if k < key
                break
    res

// Untuk timeframe besar: catat candle CHART tertinggi / terendah di setiap candle HTF,
// supaya garis HTF dimulai tepat di candle chart pembentuk swing.
// Jika tidak ketemu (history chart kurang panjang), pakai waktu candle HTF.
htf_anchor(string tf, int hi_key, int lo_key, bool is_new) =>
    var keys     = array.new_int()
    var hi_times = array.new_int()
    var lo_times = array.new_int()
    var int   cur_key  = na
    var float cur_hi   = na
    var float cur_lo   = na
    var int   cur_hi_t = na
    var int   cur_lo_t = na
    int key = time(tf)
    if na(cur_key) or key != cur_key
        if not na(cur_key)
            array.push(keys, cur_key)
            array.push(hi_times, cur_hi_t)
            array.push(lo_times, cur_lo_t)
            if array.size(keys) > 3000
                array.shift(keys)
                array.shift(hi_times)
                array.shift(lo_times)
        cur_key := key
        cur_hi  := na
        cur_lo  := na
    if na(cur_hi) or src_high > cur_hi
        cur_hi   := src_high
        cur_hi_t := time
    if na(cur_lo) or src_low < cur_lo
        cur_lo   := src_low
        cur_lo_t := time
    int hi_t = is_new ? find_time(keys, hi_times, hi_key) : na
    int lo_t = is_new ? find_time(keys, lo_times, lo_key) : na
    [na(hi_t) ? hi_key : hi_t, na(lo_t) ? lo_key : lo_t]

// Tambah level. Jika sudah ada level yang sangat dekat, level lama diganti swing baru.
add_level(float[] levels, int[] times, float price, int t) =>
    int near_i = -1
    int sz = array.size(levels)
    if sz > 0 and tol > 0
        for i = 0 to sz - 1
            if math.abs(array.get(levels, i) - price) <= tol
                near_i := i
                break
    if near_i >= 0
        array.set(levels, near_i, price)
        array.set(times, near_i, t)
    else
        array.push(levels, price)
        array.push(times, t)

// Hapus level yang sudah ditembus / terinjak atau lebih tua dari periode.
clean(float[] levels, int[] times, bool is_res) =>
    bool  by_touch = hapus == "Tersentuh"
    float px_hi    = by_touch ? src_high : close
    float px_lo    = by_touch ? src_low  : close
    if array.size(levels) > 0
        // Loop mundur supaya aman saat menghapus elemen array
        for i = array.size(levels) - 1 to 0
            float lvl = array.get(levels, i)
            int   t   = array.get(times, i)
            bool  hit = is_res ? (by_touch ? px_hi >= lvl : px_hi > lvl) : (by_touch ? px_lo <= lvl : px_lo < lvl)
            bool  old = not na(cutoff_t) and t < cutoff_t
            if hit or old
                array.remove(levels, i)
                array.remove(times, i)
    // Batas aman memori: buang yang paling jauh dari harga
    while array.size(levels) > 100
        int   far_i = 0
        float far_d = -1.0
        for i = 0 to array.size(levels) - 1
            float dist = math.abs(array.get(levels, i) - close)
            if dist > far_d
                far_d := dist
                far_i := i
        array.remove(levels, far_i)
        array.remove(times, far_i)

// Semua garis yang sedang tampil (digambar ulang di candle terakhir).
var drawn = array.new_line()
if barstate.islast
    while array.size(drawn) > 0
        line.delete(array.pop(drawn))

// Gambar level dari yang terdekat: lurus dari candle swing sampai candle terakhir.
// Resistance: urut naik (terendah = terdekat). Support: urut turun (tertinggi = terdekat).
draw_levels(float[] levels, int[] times, bool is_res, color col) =>
    int sz = array.size(levels)
    if sz > 0
        int[] idx = array.sort_indices(levels, is_res ? order.ascending : order.descending)
        int n = show_n == 0 ? sz : math.min(show_n, sz)
        for k = 0 to n - 1
            int   i     = array.get(idx, k)
            float price = array.get(levels, i)
            int   t     = array.get(times, i)
            if not na(t)
                array.push(drawn, line.new(t, price, time, price, xloc = xloc.bar_time, color = col, width = 2))

// Puncak swing -> resistance, lembah swing -> support.
// Setiap pemanggilan fungsi punya memori (var) sendiri, jadi tiap timeframe terpisah.
snr(float sh, float sl, int sh_t, int sl_t, bool is_new, bool enabled, color res_col, color sup_col) =>
    var res_levels = array.new_float()
    var res_times  = array.new_int()
    var sup_levels = array.new_float()
    var sup_times  = array.new_int()
    if enabled
        if is_new
            if not na(sh)
                add_level(res_levels, res_times, sh, sh_t)
            if not na(sl)
                add_level(sup_levels, sup_times, sl, sl_t)
        clean(res_levels, res_times, true)
        clean(sup_levels, sup_times, false)
        if barstate.islast
            draw_levels(res_levels, res_times, true,  res_col)
            draw_levels(sup_levels, sup_times, false, sup_col)

// Swing
[sh_c,   sl_c,   sht_c,   slt_c  ] = zigzag(swing_pct, use_wick, 0)
[sh_5m,  sl_5m,  sht_5m,  slt_5m ] = htf_swings("5")
[sh_15m, sl_15m, sht_15m, slt_15m] = htf_swings("15")
[sh_30m, sl_30m, sht_30m, slt_30m] = htf_swings("30")
[sh_1h,  sl_1h,  sht_1h,  slt_1h ] = htf_swings("60")
[sh_4h,  sl_4h,  sht_4h,  slt_4h ] = htf_swings("240")
[sh_d,   sl_d,   sht_d,   slt_d  ] = htf_swings("D")
[sh_w,   sl_w,   sht_w,   slt_w  ] = htf_swings("W")

new_5m  = timeframe.change("5")
new_15m = timeframe.change("15")
new_30m = timeframe.change("30")
new_1h  = timeframe.change("60")
new_4h  = timeframe.change("240")
new_d   = timeframe.change("D")
new_w   = timeframe.change("W")

// Candle chart pembentuk swing HTF
[ah_5m,  al_5m ] = htf_anchor("5",   sht_5m,  slt_5m,  new_5m)
[ah_15m, al_15m] = htf_anchor("15",  sht_15m, slt_15m, new_15m)
[ah_30m, al_30m] = htf_anchor("30",  sht_30m, slt_30m, new_30m)
[ah_1h,  al_1h ] = htf_anchor("60",  sht_1h,  slt_1h,  new_1h)
[ah_4h,  al_4h ] = htf_anchor("240", sht_4h,  slt_4h,  new_4h)
[ah_d,   al_d  ] = htf_anchor("D",   sht_d,   slt_d,   new_d)
[ah_w,   al_w  ] = htf_anchor("W",   sht_w,   slt_w,   new_w)

// Support & resistance per timeframe
snr(sh_5m,  sl_5m,  ah_5m,  al_5m,  new_5m,  show_5m  and is_higher("5"),   #00aeff,   #ffbf00)
snr(sh_15m, sl_15m, ah_15m, al_15m, new_15m, show_15m and is_higher("15"),  #00aeffdd, #ffbf00dd)
snr(sh_30m, sl_30m, ah_30m, al_30m, new_30m, show_30m and is_higher("30"),  #00aeffbb, #ffbf00bb)
snr(sh_1h,  sl_1h,  ah_1h,  al_1h,  new_1h,  show_1h  and is_higher("60"),  #00aeff90, #ffbf0090)
snr(sh_4h,  sl_4h,  ah_4h,  al_4h,  new_4h,  show_4h  and is_higher("240"), #00aeff70, #ffbf0070)
snr(sh_d,   sl_d,   ah_d,   al_d,   new_d,   show_d   and is_higher("D"),   #00aeff50, #ffbf0050)
snr(sh_w,   sl_w,   ah_w,   al_w,   new_w,   show_w   and is_higher("W"),   #00aeff30, #ffbf0030)
snr(sh_c,   sl_c,   sht_c,  slt_c,  true,    show_c,                        #ff0040,   #6aff00)

// Adaptive Moving Average
plot_ama   = input.bool(false, title = "Adaptive Moving Average")
ama_length = input.int(15, title = "Line Length")
ama_src    = close
float ama  = 0
hh         = math.max(math.sign(ta.change(ta.highest(ama_length))), 0)
ll         = math.max(math.sign(ta.change(ta.lowest(ama_length)) * -1), 0)
tc         = math.pow(ta.sma(hh or ll ? 1 : 0, ama_length), 2)

ama := nz(ama[1] + tc * (ama_src - ama[1]), ama_src)

garis_ama  = plot(plot_ama ? ama : na, "Adaptive Moving Average", #ffffff, 2)
